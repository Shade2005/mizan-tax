# ============================================================================
# Mizan (ميزان) - Root Git Ignore Configuration
# ============================================================================

# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets (Keep .env.example tracked)
.env
*.env
!.env.example
!*/.env.example
.env.local
.env.*.local
*.pem
*.key

# Build Artifacts
dist/
*/dist/
build/
web-build/
.expo/
*.tsbuildinfo

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Neon CLI Local State
.neon/
*/.neon/

# Native folders
mobile/ios/
mobile/android/
