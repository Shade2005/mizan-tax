# ============================================================================
# Mizan (ميزان) - Environment Configuration Template
# ============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend HTTP Server
PORT=4000

# Security & Multi-Tenancy JWT Configuration
# In production, JWT_SECRET MUST be a cryptographically strong string of at least 32 characters
JWT_SECRET="mizan_super_secret_jwt_key_2026_uae_tax_platform_secure"
JWT_EXPIRES_IN="3600" # 1 hour default

# Sandbox Demo Authentication Protection
# Set to 'false' in production. Must be 'false' or omitted in production deployments.
ENABLE_DEMO_AUTH=true

# Database Connection (PostgreSQL 16+ with pgvector)
DATABASE_URL="postgresql://mizan:mizan_secure_2026@localhost:5432/mizan_tax_db?schema=public"

# Distributed Rate Limiting (Optional: falls back to in-memory sliding window if omitted)
# REDIS_URL="redis://default:secret@localhost:6379"

# Google Gemini Vision OCR (Server-Side Only - NEVER expose to client)
GEMINI_API_KEY=""

# Central Bank of the UAE & Tax Engine
DEFAULT_CURRENCY="AED"
ENABLE_CBUAE_LIVE_SYNC=true

# Allowed CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:8081,http://localhost:19006,http://localhost:3000,https://mizan.ae,https://app.mizan.ae"
