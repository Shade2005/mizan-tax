{
  "name": "@uae-tax/backend",
  "version": "1.0.0",
  "description": "UAE Tax Intelligence Platform - Backend & Deterministic Tax Engine",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "prisma generate && tsc",
    "test:tax": "tsx src/tax-engine/run-tests.ts",
    "test:auth": "tsx src/auth/run-auth-production-tests.ts",
    "test:security": "tsx src/security/run-security-tests.ts",
    "test:business": "tsx src/business/run-business-tests.ts",
    "test:ai": "tsx src/ai/run-ai-tests.ts",
    "test:invoicing": "tsx src/invoicing/run-invoicing-tests.ts",
    "test:expenses": "tsx src/expenses/run-expense-tests.ts",
    "test:assessment": "tsx src/tax/run-tax-assessment-tests.ts",
    "test:dashboard": "tsx src/dashboard/run-dashboard-tests.ts",
    "test:e2e": "tsx src/e2e/run-e2e-release-tests.ts",
    "test:all": "npm run test:security && npm run test:business && npm run test:invoicing && npm run test:expenses && npm run test:tax && npm run test:assessment && npm run test:ai && npm run test:dashboard && npm run test:e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neon/config": "^1.10.1",
    "@neon/env": "^1.6.9",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.4.3",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0"
  }
}
